<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta http-equiv="refresh" content="60"/>
    <link rel="icon" href="data:,"/>
    <link rel="stylesheet" href="/app.css"/>
    <title>{{ title }}</title>
    <script>
      // theme: follow the system, same palette as the operator UI
      const mq = window.matchMedia("(prefers-color-scheme: dark)");
      const apply = () => document.documentElement.setAttribute("data-theme", mq.matches ? "afterdark" : "her");
      apply();
      mq.addEventListener("change", apply);
    </script>
</head>
<body>
<header class="navbar bg-base-200 border-b border-base-300 sticky top-0 z-10 px-8 justify-between">
    <span class="font-bold tracking-[0.16em] text-accent">{{ title | upper }}</span>
    <span class="text-xs text-base-content/70">updated {{ updated }}</span>
</header>
<div class="max-w-[880px] mx-auto px-4 pt-6 pb-12">
    {# .banner backgrounds (state class from the server) live in style.css #}
    <div class="banner {{ overall.indicator }} py-3.5 px-5 rounded-btn font-bold tracking-[0.04em] mt-4 mb-6 text-[oklch(20%_0.02_160)]">{{ overall.banner }}</div>

    {% for group in groups %}
        {% if group.name %}<div class="text-xs uppercase tracking-[0.1em] text-base-content/60 mt-6 mb-2">{{ group.name }}</div>{% endif %}
        {% for c in group.components %}
        <div class="card bg-base-200 border border-base-300 p-5 mb-4">
            <div class="flex justify-between items-baseline">
                <span>{{ c.name }}</span>
                <span class="comp-state {{ c.status }} text-xs">{{ c.status_human }}</span>
            </div>
            <div class="bars flex gap-0.5 mt-2 mb-1">
                {%- for b in c.bars -%}
                <span class="{{ b.cls }}" title="{{ b.label }}"></span>
                {%- endfor -%}
            </div>
            <div class="flex justify-between text-[10px] text-base-content/45">
                <span>{{ history_days }} days ago</span>
                <span>{{ c.uptime_label }}</span>
                <span>today</span>
            </div>
        </div>
        {% endfor %}
    {% endfor %}

    {% if open_incidents %}
    <div class="text-xs uppercase tracking-[0.1em] text-base-content/60 mt-6 mb-2">Active incidents</div>
    {% for i in open_incidents %}
    <div class="card bg-base-200 border border-base-300 p-5 mb-4">
        <h4 class="m-0 mb-1 text-sm font-bold">{{ i.title }}</h4>
        <span class="text-[11px] text-base-content/55">opened {{ i.opened_human }}</span>
        <ul class="list-none mt-2 mb-0 p-0 border-l-2 border-base-300">
            {% for u in i.updates %}
            <li class="py-0.5 pl-3 text-xs text-base-content/85"><span class="text-[11px] text-base-content/55 mr-2">{{ u.when }}</span>{{ u.message }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endfor %}
    {% endif %}

    {% if resolved_incidents %}
    <div class="text-xs uppercase tracking-[0.1em] text-base-content/60 mt-6 mb-2">Past incidents</div>
    {% for i in resolved_incidents %}
    <div class="card bg-base-200 border border-base-300 p-5 mb-4">
        <h4 class="m-0 text-sm font-bold">{{ i.title }}<span class="text-[11px] text-success ml-2 font-normal">resolved</span></h4>
        <span class="text-[11px] text-base-content/55">{{ i.opened_human }} → {{ i.resolved_human }}</span>
    </div>
    {% endfor %}
    {% endif %}

    <footer class="mt-10 text-[11px] text-base-content/40">powered by dabping · <a href="/api/status.json">status.json</a></footer>
</div>
</body>
</html>
